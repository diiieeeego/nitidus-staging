# Copy to .env.local for local development. On Vercel set these under
# Project → Settings → Environment Variables. Never commit real secrets.

# Optional. Unset = "smtp" when all SMTP_* below are set, otherwise "disabled"
# (no mail is sent; the form shows the phone/email fallback). "log" prints
# inquiries to the server console (local development only). Set "smtp"
# explicitly to make a missing SMTP_* variable fail the build.
# MAIL_TRANSPORT=smtp

# SMTP account that sends inquiry emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# "true" for implicit TLS (port 465), "false" for STARTTLS (port 587)
SMTP_SECURE=false
SMTP_USER=web@example.com
SMTP_PASS=change-me
SMTP_FROM="Nitidus web <web@example.com>"

# Where inquiries are delivered (reply-to is set to the visitor's address)
INQUIRY_EMAIL=nitidusdoo@gmail.com

# Optional: random string, at least 16 characters (e.g. `openssl rand -hex 24`).
# Unset = random per server process (fine – the rate limit is in memory anyway).
IP_HASH_SALT=replace-with-a-long-random-string

# Public origin used for canonical URLs, sitemap and Open Graph
SITE_URL=https://nitidus.hr
